# 后端环境变量示例（复制为 .env 使用；.env 不入库）

# 服务端口（#84 决策 D1：前端 3000 / 后端 3001，vite proxy / nginx 同源转发）
PORT=3001

# MySQL 连接（本地演示默认值，按需修改）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=wemove123
DB_NAME=wemove_portal

# 会话 JWT 签名密钥（生产环境必须更换为强随机值）
JWT_SECRET=wemove-dev-secret-change-me
JWT_EXPIRES_IN=7d
