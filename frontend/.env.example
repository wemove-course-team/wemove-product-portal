# 前端环境变量示例（复制为 .env.local 使用；.env*.local 不入库）

# API 模式：real（默认，走真实后端，失败呈现错误状态）| mock（显式演示开关，界面显示 Mock 标识）
VITE_API_MODE=real

# API 前缀（#85 契约 v1：/api/v1，与后端统一前缀一致，一般无需修改）
VITE_API_BASE_URL=/api/v1

# 单请求超时（毫秒）
VITE_HTTP_TIMEOUT_MS=15000

# 开发代理目标（vite.config.js 读取，默认 http://localhost:3001）
# VITE_API_PROXY_TARGET=http://localhost:3001
