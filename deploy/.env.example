# WEMOVE 部署变量示例。复制为 deploy/.env 后再填写真实值；不要提交 deploy/.env。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_USER=wemove
MYSQL_PASSWORD=replace-with-a-strong-app-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# 只能填 CI/CD 已验证的完整提交 SHA；禁止 latest 或其他可变标签。
IMAGE_TAG=REPLACE_WITH_VERIFIED_GIT_SHA
WEMOVE_HTTP_PORT=8080
# 仅 docker-compose.local.yml 使用；绑定 127.0.0.1，供本地 e2e。
WEMOVE_MYSQL_PORT=3306
